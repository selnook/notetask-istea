{
  "expo": {
    "name": "NoteTask",
    "slug": "NoteTask",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "NoteTask necesita acceder a tus fotos para adjuntarlas a las tareas.",
          "cameraPermission": "NoteTask necesita usar la cámara para sacar fotos de las tareas.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.selnook.NoteTask",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bafc737b-12f5-4803-ba86-82f0e64440a9"
      }
    }
  }
}
